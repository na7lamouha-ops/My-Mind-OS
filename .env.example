# ---------------------------------------------------------------------------
# My Mind OS — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit .env.local
# ---------------------------------------------------------------------------

# Supabase — public values, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Supabase — SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never import in a
# client component. Used only inside server routes / server actions.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# AI provider — SERVER ONLY. Every AI call goes through a Next.js Route Handler,
# never from the browser. Left unused in Milestone 1 (no AI yet).
ANTHROPIC_API_KEY=

# Public site URL, used for auth redirect callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
